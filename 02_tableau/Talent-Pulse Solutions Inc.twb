                <story-points>
                  <story-point caption='Compared to total population of employees, 16.36% if the employees left the organisation' captured-sheet='KPI Attrition Rate' id='1' />
                  <story-point caption='This is the total number of employees that left' captured-sheet='Attrition KPI' id='2' />
                  <story-point caption='This is the overall number of employee' captured-sheet='Employees KPI' id='3' />
                  <story-point caption='Attrition was broken down into departments and R&amp;D has the highes number of attrition.' captured-sheet='Department' id='4' />
                  <story-point caption='Male has the highest number of attrition' captured-sheet='Gender' id='5' />
                  <story-point caption='This Attrition  by Job Role, Sales Executive has the highest retention.' captured-sheet='Job Role' id='6' />
                  <story-point caption='This is attrition by Education and Marketing has the highest attrition' captured-sheet='Educational Field' id='7' />
                  <story-point caption='This is trend analysis on years in role. Two employees have spent 15years in their current role.' captured-sheet='Attrition Trend' id='8' />
                  <story-point caption='This is survey score analysis. This shows that 20 Laboratory Technicians has the highest Job Satisfaction.' captured-sheet='Survey Score' id='9' />
                  <story-point caption='This is HR Analytics Dashboard showing  the analysis in one view.' captured-sheet='HR Analytics Dashboard' id='10' />
                </story-points>
