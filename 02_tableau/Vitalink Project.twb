      <column caption='Alert Date' datatype='datetime' name='[AlertDate]' role='dimension' type='ordinal' />
      <column caption='Alert ID' datatype='string' name='[AlertID]' role='dimension' type='nominal' />
      <column caption='Alert Severity' datatype='string' name='[AlertSeverity]' role='dimension' type='nominal' />
      <column caption='Battery Status' datatype='real' name='[Battery_Status]' role='measure' type='quantitative' />
      <column caption='SLA Status' datatype='string' name='[Calculation_2155909064744960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Response_Time_Hrs] &lt;= 2 THEN&#13;&#10;    &quot;Met SLA&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Breached SLA&quot;&#13;&#10;END' />
      </column>
      <column caption='SLA Compliance %' datatype='real' default-format='p0.0%' name='[Calculation_2155909065412609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_2155909064744960] = &quot;Met SLA&quot; THEN [AlertID] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([AlertID])' />
      </column>
      <column caption='SLA Breaches' datatype='integer' name='[Calculation_2155909065740290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [Calculation_2155909064744960] = &quot;Breached SLA&quot; THEN [AlertID] END&#13;&#10;)' />
      </column>
      <column caption='Critical SLA Compliance %' datatype='real' default-format='p0.0%' name='[Calculation_2155909066547203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [AlertSeverity] = &quot;Critical&quot;&#13;&#10;    AND [Calculation_2155909064744960] = &quot;Met SLA&quot;&#13;&#10;    THEN [AlertID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF [AlertSeverity] = &quot;Critical&quot;&#13;&#10;    THEN [AlertID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Warning Alert Rate' datatype='real' default-format='p0.0%' name='[Calculation_2155909067218948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [AlertSeverity] = &quot;Warning&quot;&#13;&#10;    THEN [AlertID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([AlertID])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_2155909069336581]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PatientAge] &lt;= 54 THEN &quot;45–54&quot;&#13;&#10;ELSEIF [PatientAge] &lt;= 64 THEN &quot;55–64&quot;&#13;&#10;ELSEIF [PatientAge] &lt;= 74 THEN &quot;65–74&quot;&#13;&#10;ELSEIF [PatientAge] &lt;= 84 THEN &quot;75–84&quot;&#13;&#10;ELSE &quot;85+&quot;&#13;&#10;END' />
      </column>
      <column caption='Critical Alert Count' datatype='integer' name='[Calculation_2155909069623302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [AlertSeverity] = &quot;Critical&quot;&#13;&#10;    THEN [AlertID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Critical Alert %' datatype='real' default-format='p0.0%' name='[Calculation_2155909069791239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2155909069623302] / COUNT([AlertID])' />
      </column>
      <column caption='Patients with Alerts' datatype='integer' name='[Calculation_2155909070761992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([PatientID])' />
      </column>
      <column caption='Total Alerts' datatype='integer' name='[Calculation_2155909071073289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([AlertID])' />
      </column>
      <column caption='Warning Alert Count' datatype='integer' name='[Calculation_2155909071335434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [AlertSeverity] = &quot;Warning&quot;&#13;&#10;    THEN [AlertID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='0' datatype='integer' name='[Calculation_2155909172760596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
